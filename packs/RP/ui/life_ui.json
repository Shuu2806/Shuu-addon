{
    "namespace": "server_form",

    "revive_panel": {
        "type": "panel",
        "focus_container": true,
        "size": [240, 200],
        "layer": 2,
        "controls": [
            { "shell@server_form.sa_page_shell": {} },
            { "info@server_form.sa_info_box": { "offset": [0, 32], "anchor_from": "top_middle", "anchor_to": "top_middle", "layer": 4 } },
            { "list@server_form.life_scroll_panel": {
                "offset": [0, 60],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "layer": 4
            } }
        ]
    },

    "life_scroll_panel": {
        "type" : "stack_panel",
        "size" : ["100%", "100% - 68px"],
        "orientation" : "vertical",
        "layer" : 1,
        "anchor_from" : "top_left",
        "anchor_to" : "top_left",
        "controls" : [
            {
                "scrolling_panel@common.scrolling_panel": {
                    "anchor_from" : "top_left",
                    "anchor_to" : "top_left",
                    "$show_background": false,
                    "size" : ["100%", "100%"],
                    "$scrolling_content" : "server_form.life_player_grid_panel",
                    "$scroll_size": [5, "100% - 4px"],
                    "$scrolling_pane_size": ["100% - 4px", "100% -2px"],
                    "$scrolling_pane_offset": [2,0],
                    "$scroll_bar_right_padding_size": [0,0]
                }
            }
        ]
    },

    "life_player_grid_panel": {
        "type" : "panel",
        "size" : ["100%", "100%c"],
        "controls" : [
            {
                "dynamic_buttons_panel" : {
                    "type" : "grid",
                    "size" : ["100%", "100%c"],
                    "grid_dimensions" : [3, 3],
                    "grid_item_template": "server_form.sa_btn",
                    "grid_fill_direction": "horizontal",
                    "grid_rescaling_type": "horizontal",

                    "anchor_from" : "center",
                    "anchor_to" : "center",

                    "factory" :{
                        "name" : "buttons",
                        "control_name": "server_form.sa_btn"
                    },

                    "collection_name": "form_buttons",
                    "bindings": [ 
                        { 
                            "binding_name": "#form_button_length", 
                            "binding_name_override": "#maximum_grid_items"
                        } 
                    ]

                }
            }
        ]
    }
}
