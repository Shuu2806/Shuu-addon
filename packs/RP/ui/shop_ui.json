{
    "namespace": "server_form",

    "shop_btn_grid": {
        "type": "panel",
        "size": ["50%", "100%"],
        "collection_name": "form_buttons",
        "controls": [
            { "click@server_form.sa_btn_core": {} },
            { "icon@server_form.sa_btn_icon": { "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 4] } },
            { "lbl@server_form.sa_btn_lbl": { "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "offset": [0, -4] } }
        ]
    },

    "shop_btn_wide": {
        "type": "panel",
        "size": ["100%", "100%"],
        "collection_name": "form_buttons",
        "controls": [
            { "click@server_form.sa_btn_core": {} },
            { "icon@server_form.sa_btn_icon": { "anchor_from": "center_left", "anchor_to": "center_left", "offset": [-30, 0] } },
            { "lbl@server_form.sa_btn_lbl": { "anchor_from": "center", "anchor_to": "center" } }
        ]
    },

    "shop_btn_action": {
        "type": "panel",
        "size": ["65%", "100%"],
        "collection_name": "form_buttons",
        "controls": [
            { "click@server_form.sa_btn_core": {} },
            { "icon@server_form.sa_btn_icon": { "anchor_from": "center_left", "anchor_to": "center_left", "offset": [-30, 0] } },
            { "lbl@server_form.sa_btn_lbl": { "anchor_from": "center", "anchor_to": "center", "offset": [20, 0] } }
        ]
    },

    "shop_btn_return": {
        "type": "panel",
        "size": ["35%", "100%"],
        "collection_name": "form_buttons",
        "controls": [
            { "click@server_form.sa_btn_core": {} },
            { "icon@server_form.sa_btn_icon": { "anchor_from": "center_left", "anchor_to": "center_left", "offset": [-15, 0] } },
            { "lbl@server_form.sa_btn_lbl": { "anchor_from": "center", "anchor_to": "center", "offset": [10, 0] } }
        ]
    },

    "cag_contribuer_btn": {
        "type": "panel",
        "size": ["65%", "100%"],
        "collection_name": "form_buttons",
        "controls": [
            { "click@server_form.sa_btn_core": {} },
            {
                "icon": {
                    "type": "image",
                    "size": [22, 22],
                    "texture": "textures/items/diamond",
                    "anchor_from": "center_left",
                    "anchor_to": "center_left",
                    "offset": [-20, 0],
                    "layer": 4
                }
            },
            { "lbl@server_form.sa_btn_lbl": { "anchor_from": "center", "anchor_to": "center", "offset": [20, 0] } }
        ]
    },

    "cag_amounts_inner": {
        "type": "panel",
        "size": ["100% - 16px", 16],
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "collection_name": "form_buttons",
        "controls": [
            {
                "lbl": {
                    "type": "label",
                    "text": "#form_button_text",
                    "text_alignment": "center",
                    "color": [1, 1, 1],
                    "font_size": "normal",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 4,
                    "bindings": [{ "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }]
                }
            }
        ]
    },

    "cag_bar_inner": {
        "type": "panel",
        "size": ["100% - 16px", 18],
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "collection_name": "form_buttons",
        "controls": [
            { "bg@server_form.sa_bg_element": {} },
            {
                "bar": {
                    "type": "image",
                    "size": ["100%", "100%"],
                    "layer": 2,
                    "bindings": [{ "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" }]
                }
            }
        ]
    },

    "cag_list_item": {
        "type": "panel",
        "size": ["100%", 44],
        "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
        ],
        "controls": [
            { "click@server_form.sa_btn_core": { "size": ["100%", "100% - 2px"] } },
            {
                "name_lbl": {
                    "type": "label",
                    "text": "#form_button_text",
                    "color": [1, 1, 1],
                    "text_alignment": "center",
                    "font_size": "small",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, 8],
                    "size": ["100%", "100%"],
                    "layer": 4,
                    "bindings": [{ "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }]
                }
            },
            {
                "bar": {
                    "type": "image",
                    "size": ["90%", 8],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "offset": [0, -8],
                    "layer": 4,
                    "bindings": [{ "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" }]
                }
            }
        ]
    },

    "shop_main_panel": {
        "type": "panel",
        "focus_container": true,
        "size": [280, 220],
        "layer": 2,
        "controls": [
            { "shell@server_form.sa_page_shell": {} },
            { "bal@server_form.sa_balance_box": { "size": ["100% - 16px", 24], "offset": [0, 32] } },
            {
                "grid_area": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["100% - 16px", "100% - 76px"],
                    "offset": [0, 62],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "collection_name": "form_buttons",
                    "controls": [
                        {
                            "row1": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%", 48],
                                "collection_name": "form_buttons",
                                "controls": [
                                    { "b0@server_form.shop_btn_grid": { "collection_index": 0 } },
                                    { "b1@server_form.shop_btn_grid": { "collection_index": 1 } }
                                ]
                            }
                        },
                        {
                            "row2": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%", 48],
                                "collection_name": "form_buttons",
                                "controls": [
                                    { "b2@server_form.shop_btn_grid": { "collection_index": 2 } },
                                    { "b3@server_form.shop_btn_grid": { "collection_index": 3 } }
                                ]
                            }
                        },
                        { "gap": { "type": "panel", "size": ["100%", 6] } },
                        {
                            "wide_row": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%", 36],
                                "collection_name": "form_buttons",
                                "controls": [
                                    { "b4@server_form.shop_btn_wide": { "collection_index": 4 } }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "shop_item_panel": {
        "type": "panel",
        "focus_container": true,
        "size": [260, 138],
        "layer": 2,
        "controls": [
            { "shell@server_form.sa_page_shell": {} },
            { "bal@server_form.sa_balance_box": { "size": ["100% - 16px", 24], "offset": [0, 32] } },
            {
                "btns": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100% - 16px", 60],
                    "offset": [0, -8],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "collection_name": "form_buttons",
                    "controls": [
                        { "b0@server_form.shop_btn_action": { "collection_index": 0 } },
                        { "b1@server_form.shop_btn_return": { "collection_index": 1 } }
                    ]
                }
            }
        ]
    },

    "cag_list_panel": {
        "type": "panel",
        "focus_container": true,
        "size": [300, 240],
        "layer": 2,
        "controls": [
            { "shell@server_form.sa_page_shell": {} },
            {
                "header": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100% - 16px", 36],
                    "offset": [0, 32],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "controls": [
                        {
                            "info_box": {
                                "type": "panel",
                                "size": ["75%", "100%"],
                                "controls": [
                                    { "bg@server_form.sa_bg_element": { "size": ["100% - 3px", "100% - 3px"] } },
                                    { "txt@server_form.sa_body_lbl": { "anchor_from": "center", "anchor_to": "center", "layer": 4 } }
                                ]
                            }
                        },
                        {
                            "back_btn": {
                                "type": "button",
                                "size": ["25%", "100%"],
                                "focus_enabled": true,
                                "default_control": "def",
                                "hover_control": "hov",
                                "pressed_control": "hov",
                                "controls": [
                                    {
                                        "def": {
                                            "type": "panel",
                                            "size": ["100% - 3px", "100% - 3px"],
                                            "controls": [
                                                { "bg@server_form.sa_bg_button": {} },
                                                { "lbl": { "type": "label", "text": "§bRetour", "text_alignment": "center", "font_size": "small", "color": [1, 1, 1], "anchor_from": "center", "anchor_to": "center", "layer": 4 } }
                                            ]
                                        }
                                    },
                                    {
                                        "hov": {
                                            "type": "panel",
                                            "size": ["100% - 3px", "100% - 3px"],
                                            "controls": [
                                                { "bg@server_form.sa_bg_button_hover": {} },
                                                { "lbl": { "type": "label", "text": "§bRetour", "text_alignment": "center", "font_size": "small", "color": [1, 1, 1], "anchor_from": "center", "anchor_to": "center", "layer": 4 } }
                                            ]
                                        }
                                    }
                                ],
                                "button_mappings": [
                                    { "from_button_id": "button.menu_select", "to_button_id": "button.menu_exit", "mapping_type": "pressed" },
                                    { "from_button_id": "button.menu_ok", "to_button_id": "button.menu_exit", "mapping_type": "focused" }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "cag_list": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["100% - 16px", "100% - 80px"],
                    "offset": [0, 74],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "factory": {
                        "name": "buttons",
                        "control_ids": { "button": "server_form.cag_list_item" }
                    },
                    "collection_name": "form_buttons",
                    "bindings": [
                        { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }
                    ]
                }
            }
        ]
    },

    "cag_detail_panel": {
        "type": "panel",
        "focus_container": true,
        "size": [280, 215],
        "collection_name": "form_buttons",
        "layer": 2,
        "controls": [
            { "shell@server_form.sa_page_shell": {} },
            { "amounts@server_form.cag_amounts_inner": { "collection_index": 0, "offset": [0, 32] } },
            { "bar@server_form.cag_bar_inner": { "collection_index": 0, "offset": [0, 52] } },
            {
                "contrib_box": {
                    "type": "panel",
                    "size": ["100% - 16px", 78],
                    "offset": [0, 76],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "controls": [
                        { "bg@server_form.sa_bg_element": {} },
                        {
                            "txt": {
                                "type": "label",
                                "text": "#form_text",
                                "color": [1, 1, 1],
                                "font_size": "small",
                                "text_alignment": "center",
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "offset": [0, 6],
                                "size": ["100% - 8px", "100% - 12px"],
                                "layer": 4,
                                "bindings": [{ "binding_name": "#form_text" }]
                            }
                        }
                    ]
                }
            },
            {
                "btns": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100% - 16px", 48],
                    "offset": [0, -8],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "collection_name": "form_buttons",
                    "controls": [
                        { "b1@server_form.cag_contribuer_btn": { "collection_index": 1 } },
                        { "b2@server_form.shop_btn_return":    { "collection_index": 2 } }
                    ]
                }
            }
        ]
    }
}
