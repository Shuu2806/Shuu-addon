    "jobs_grid_panel": {
        "type" : "panel",
        "size" : ["100%", "100%"],
        "controls" : [
            {
                "dynamic_buttons_panel" : {
                    "type" : "grid",
                    "size" : ["100%", "100%c"],
                    "grid_dimensions" : [3, 3],
                    "grid_item_template": "server_form.jobs_btn_combined",
                    "grid_fill_direction": "horizontal",
                    "grid_rescaling_type": "horizontal",

                    "anchor_from" : "top_middle",
                    "anchor_to" : "top_middle",

                    "factory" :{
                        "name" : "buttons",
                        "control_name": "server_form.jobs_btn_combined"
                    },

                    "collection_name": "form_buttons",
                    "bindings": [ 
                        { 
                            "binding_name": "#form_button_length", 
                            "binding_name_override": "#maximum_grid_items"
                        } 
                    ]

                }
            }
        ]
    },

